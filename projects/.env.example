# projects/.env のテンプレート（こちらはコミットされる。値は絶対に書かない）
# 使い方: このファイルを .env にコピーして実値を入れる
#   cp projects/.env.example projects/.env

# --- MCP サーバ接続用 -----------------------------------------
# NOTION_MCP_TOKEN=
# GITHUB_PERSONAL_ACCESS_TOKEN=

# --- 外部 API キー --------------------------------------------
# ANTHROPIC_API_KEY=
# OPENWEATHER_API_KEY=
# STRIPE_SECRET_KEY=

# --- データベース / その他接続情報 -----------------------------
# DATABASE_URL=
