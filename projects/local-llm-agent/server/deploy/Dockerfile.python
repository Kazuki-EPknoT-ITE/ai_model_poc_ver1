# 自作の Python サービス（gateway / web-relay / ocr）の共通イメージ。リポジトリのルートで:
#   docker build -f projects/local-llm-agent/server/deploy/Dockerfile.python --build-arg PACKAGE=llm-gateway .
# uv の workspace から、そのパッケージに必要なものだけを入れる（lock は固定）。
FROM python:3.12-slim AS build
ARG PACKAGE
ARG PACKAGE_DIR=""
COPY --from=ghcr.io/astral-sh/uv:0.10.4 /uv /usr/local/bin/uv
WORKDIR /src
COPY projects/local-llm-agent/ ./
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
# workspace のメンバーなら --package で、独立したプロジェクト（PACKAGE_DIR）ならその場所で同期する
RUN if [ -n "$PACKAGE_DIR" ]; then cd "$PACKAGE_DIR" && uv sync --no-dev && mv .venv /venv; \
    else uv sync --frozen --no-dev --package "$PACKAGE" && mv .venv /venv; fi

FROM python:3.12-slim
RUN useradd --system --uid 10001 app \
    && apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /venv /venv
ENV PATH="/venv/bin:$PATH" PYTHONUNBUFFERED=1
USER app
