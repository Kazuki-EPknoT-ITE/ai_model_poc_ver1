# server/deploy の変数（実値は /srv/llm/secrets/deploy.env に置く。コミットしない）
# 版は M0 で確定し VERSIONS.md に記録する
VLLM_IMAGE=vllm/vllm-openai:CHANGE_ME
QDRANT_IMAGE=qdrant/qdrant:CHANGE_ME
POSTGRES_IMAGE=postgres:16
PROMETHEUS_IMAGE=prom/prometheus:CHANGE_ME
GRAFANA_IMAGE=grafana/grafana:CHANGE_ME
DCGM_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:CHANGE_ME
ALERTMANAGER_IMAGE=prom/alertmanager:CHANGE_ME
NODE_EXPORTER_IMAGE=prom/node-exporter:CHANGE_ME
APP_TAG=dev

# 公開するサーバーの IP（社内LAN）
SERVER_IP=192.168.0.10

# モデル（/srv/llm/models 以下の相対パス）
MODEL_12B=base/gemma-4-12b-it-qat-int4/REVISION
MODEL_26B=base/gemma-4-26b-a4b-it-int4/REVISION
# 検証機 32K / 本番機 64K（PRF-04）
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=5
GPU_UTIL_12B=0.85
GPU_UTIL_26B=0.60
# vLLM の版によって構造化出力の指定が違う（server_setup.md §5.4 の注意）
GUIDED_DECODING_ARGS=--guided-decoding-backend xgrammar
