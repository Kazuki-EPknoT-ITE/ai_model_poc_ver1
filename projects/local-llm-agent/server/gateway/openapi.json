  "components": {
    "schemas": {
      "AuditBatch": {
        "properties": {
          "records": {
            "items": {
              "$ref": "#/components/schemas/ClientAuditRecord"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Records"
          }
        },
        "type": "object",
        "required": [
          "records"
        ],
        "title": "AuditBatch"
      },
      "ClientAuditRecord": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Id"
          },
          "at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "At"
          },
          "action": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Action"
          },
          "target": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          },
          "result": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Result"
          },
          "detail": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "id",
          "action",
          "result"
        ],
        "title": "ClientAuditRecord"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginBody": {
        "properties": {
          "login": {
            "type": "string",
            "maxLength": 256,
            "title": "Login"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "title": "Password"
          },
          "device_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Name"
          }
        },
        "type": "object",
        "required": [
          "login",
          "password"
        ],
        "title": "LoginBody"
      },
      "PasswordBody": {
        "properties": {
          "current": {
            "type": "string",
            "maxLength": 1024,
            "title": "Current"
          },
          "new": {
            "type": "string",
            "maxLength": 1024,
            "title": "New"
          }
        },
        "type": "object",
        "required": [
          "current",
          "new"
        ],
        "title": "PasswordBody"
      },
      "RefreshBody": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "maxLength": 512,
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshBody"
      },
      "UserCreate": {
        "properties": {
          "login": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._@-]+$",
            "title": "Login"
          },
          "display_name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Display Name"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ],
            "title": "Role",
            "default": "user"
          },
          "department": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Department"
          },
          "max_concurrent": {
            "type": "integer",
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Max Concurrent",
            "default": 2
          },
          "net_level_cap": {
            "type": "string",
            "enum": [
              "off",
              "search",
              "browse"
            ],
            "title": "Net Level Cap",
            "default": "off"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "login",
          "display_name",
          "password"
        ],
        "title": "UserCreate"
      },
      "UserPatch": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "password": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Password"
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "user",
                  "admin"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "department": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Department"
          },
          "max_concurrent": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 64.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Concurrent"
          },
          "net_level_cap": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "off",
                  "search",
                  "browse"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Net Level Cap"
          },
          "disabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disabled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "UserPatch"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
